<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.llama-defender.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jinsongwang/APP/llama.cpp/tools/startup_stack.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jinsongwang/APP/llama.cpp</string>
  <key>RunAtLoad</key><true/>
  <!-- KeepAlive={"SuccessfulExit":false}：仅在**异常退出**（非零）时重启本作业；
       wrapper 检测到人工 service_stop 则 exit 0 → 不再拉起（尊重人工停机）。
       另：wrapper 必须常驻前台（tools/startup_stack.sh 的守栈循环），否则 launchd
       回收作业进程组会连坐杀掉引擎/代理（DEF-324）。 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/jinsongwang</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/jinsongwang/APP/llama.cpp/logs/startup-stack.out</string>
  <key>StandardErrorPath</key><string>/Users/jinsongwang/APP/llama.cpp/logs/startup-stack.out</string>
</dict>
</plist>
