# macOS
.DS_Store

# Logs
logs/
*.log

# Playwright MCP temp files
.playwright-mcp/

# Active config symlink (machine-local)
configs/active.conf

# Local secrets (API keys) — never track
configs/secret.local.conf
configs/*.secret
configs/*.local.conf

# Python cache
__pycache__/
*.pyc

# Local Python venvs (e.g. .venv-rapidmlx, pinned backend versions)
.venv*/

# Editor
.vscode/
.idea/
.opencode/
*.swp
*.swo

# Runtime artifacts
*.pid

# Model files (large binaries)
models/

# Kimi export files
kimi-export-*.md

# Backup files
*.bak.*
*.bak
configs/*.bak.*
node_modules/
package-lock.json
.aider*
.manage.lock

# 自建引擎二进制（如 embedgemma2 用的 llama-server）
tools/bin/

# 语义检索索引（tools/semantic_search.py 生成，向量文件较大）
.semantic/

# AI 工具本地状态/偏好（可能含明文 API key，如 .claude/settings.local.json
# 的 SERPER_API_KEY / HF_TOKEN）——绝不入库
.claude/
.agents/
.commandcode/

# 生成的报告/导出产物
output/
