# macOS
.DS_Store

# Logs
logs/
*.log

# Playwright MCP temp files
.playwright-mcp/

# Active config symlink (machine-local)
configs/active.conf

# Local secrets (API keys) — never track
configs/secret.local.conf
configs/*.secret
configs/*.local.conf

# Python cache
__pycache__/
*.pyc

# Local Python venvs (e.g. .venv-rapidmlx, pinned backend versions)
.venv*/

# Editor
.vscode/
.idea/
.opencode/
*.swp
*.swo

# Runtime artifacts
*.pid

# Model files (large binaries)
models/

# Kimi export files
kimi-export-*.md

# Backup files
*.bak.*
*.bak
configs/*.bak.*
node_modules/
package-lock.json
.aider*
.manage.lock

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
