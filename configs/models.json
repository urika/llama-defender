{
  "_comment": "模型目录（Model Catalog）— Phase A/B。providers=部署拓扑, models=模型固有属性, routes=别名绑定策略。与 multi-cloud-model-catalog-design-20260815.md 对齐。删除本文件 => registry 合成等价目录（行为与引入前完全一致）。'$env' 跟随 PROXY_CLOUD_MODEL（热重载生效）；'$default' 取 defaults.cloud_model。端点校验(2026-08-15, 官方文档+真实冒烟)：zhipu=docs.bigmodel.cn 的 open.bigmodel.cn/api/paas/v4（key 有效，429/1113=余额不足需充值）；kimi=api.kimi.com/coding/v1（Kimi Code 会员订阅体系，key 验证 200，与 api.moonshot.cn 开放平台是两套独立体系/计费）；moonshot=platform.kimi.com 的 api.moonshot.cn/v1（按量计费，key 未配→fallback 链自动跳过；本机网络直连超时待查）。kimi 能力元数据取自 /coding/v1/models 实测（k3=1048576 ctx, thinking only, vision）。quirk 备注：zhipu temperature 区间 (0,1) 不支持 0；moonshot 平台 kimi-k3 支持顶层 reasoning_effort low/high/max；glm/kimi price 仍缺官方价待补（无 price 条目回退全局 PROXY_CLOUD_PRICE_*）。",

  "providers": {
    "deepseek": {
      "base_url_env": "PROXY_CLOUD_BASE_URL",
      "anthropic_base_url": "https://api.deepseek.com/anthropic",
      "anthropic_compatible": true,
      "key_env": "PROXY_CLOUD_API_KEY",
      "concurrent_env": "PROXY_ROUTE_CLOUD_CONCURRENT"
    },
    "zhipu": {
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "anthropic_base_url": "https://open.bigmodel.cn/api/anthropic",
      "anthropic_compatible": true,
      "key_env": "ZHIPU_API_KEY",
      "concurrent": 2
    },
    "kimi": {
      "base_url": "https://api.kimi.com/coding/v1",
      "anthropic_base_url": "https://api.kimi.com/coding/",
      "anthropic_compatible": true,
      "key_env": "KIMI_API_KEY",
      "concurrent": 2
    },
    "moonshot": {
      "base_url": "https://api.moonshot.cn/v1",
      "anthropic_compatible": false,
      "key_env": "MOONSHOT_API_KEY",
      "concurrent": 2
    },
    "local": {
      "base_url_env": "LLAMA_BASE_URL",
      "key_env": "LLAMA_API_KEY",
      "concurrent_env": "PROXY_MAX_CONCURRENT",
      "anthropic_compatible": false
    }
  },

  "models": {
