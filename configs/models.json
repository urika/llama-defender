  "routes": {
    "claude-sonnet-4-6": {
      "route_bias": "auto",
      "cloud_model": "$default",
      "behavior": "prefer",
      "threshold_factor": 1.0,
      "memory_bias": 0
    },
    "claude-opus-4-7": {
      "route_bias": "prefer_cloud",
      "cloud_model": "deepseek-v4-pro",
      "behavior": "force_fallback",
      "threshold_factor": 0.8,
      "memory_bias": -5
    },
    "claude-haiku-4-5": {
      "route_bias": "prefer_local",
      "cloud_model": "$default",
      "behavior": "prefer",
      "threshold_factor": 1.33,
      "memory_bias": 0
    }
  },

  "defaults": {
    "cloud_model": "$env",
    "daily_budget": 5.0
  }
